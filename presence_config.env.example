# MQTT Broker
MQTT_BROKER=192.168.1.100
MQTT_PORT=1883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password

# Serial port for LD2420 (after enabling UART on Pi)
SERIAL_PORT=/dev/serial0
SERIAL_BAUD=256000

# HDMI-CEC screen power control (true/false)
HDMI_POWER_CONTROL=true

# Minimum seconds the screen stays ON once triggered.
# This is the "off delay after last detected presence" — set it to how long
# the screen should stay lit after you leave. Tuning notes:
#   - 30s: screen off ~30s after absence (good for a kitchen glance)
#   - If the radar (mounted behind the LCD) loses a perfectly still person
#     after ~30s, a longer hold (60-120s) masks that limitation but keeps the
#     screen on after you leave — a compromise, not a fix.
MIN_ON_TIME=30

# Still energy threshold — sensor reports 0-100+; baseline ~3-5, close range 50-100.
# Lower = faster turn-on when approaching (40 instead of 50 turns on earlier).
STILL_ENERGY_THRESHOLD=40

# Release energy threshold — once a target is held, still_energy must drop below
# THIS (not the confirm threshold) to start the release countdown. Hysteresis that
# stops energy flicker (e.g. 30-50) from turning the screen off while standing still.
RELEASE_ENERGY_THRESHOLD=10

# Confirm/release frames (at ~10Hz update rate)
CONFIRM_FRAMES=5
RELEASE_FRAMES=10

# LD2420 gate config (max gate to enable)
MAX_GATE=1

# Gate 0 sensitivity (default 30 if not set).
# LD2420 is mounted behind the LCD, so signal is attenuated. Tuning notes:
#   - GATE0_STATIC=20 (default) loses a standing person after ~4s
#   - GATE0_STATIC=10 holds a standing person ~30s (recommended); try 5 if deeper
# Lower = more sensitive. GATE0_MOVING can also be lowered for closer range.
GATE0_MOVING=15
GATE0_STATIC=10

# MQTT discovery prefix
DISCOVERY_PREFIX=homeassistant
