# MQTT Broker
MQTT_BROKER=192.168.1.100
MQTT_PORT=1883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password

# Serial port for LD2420 (after enabling UART on Pi)
SERIAL_PORT=/dev/serial0
SERIAL_BAUD=256000

# HDMI-CEC screen power control (true/false)
HDMI_POWER_CONTROL=true

# Minimum seconds the screen stays ON once triggered.
# With the new thresholds (STILL_ENERGY_THRESHOLD=15, RELEASE_ENERGY_THRESHOLD=8),
# presence is detected reliably. MIN_ON_TIME is now purely the "off delay after
# you walk away" — how long the screen stays lit after absence. 30s is good for
# a kitchen glance; increase to 60s if you want a longer buffer.
MIN_ON_TIME=30

# Still energy threshold — sensor reports 0-100+; baseline ~3-5.
# LD2420 behind LCD attenuates signal: a standing person typically reads 15-29.
# Set this ABOVE baseline but BELOW typical standing energy. With the sensor
# behind an LCD, 15 works reliably (50 was far too high).
STILL_ENERGY_THRESHOLD=15

# Release energy threshold — once a target is held, still_energy must drop below
# THIS (not the confirm threshold) to start the release countdown. Hysteresis that
# stops energy flicker from turning the screen off while standing still.
# Set below STILL_ENERGY_THRESHOLD. 8 = very forgiving (screen stays on as long
# as still_e > 8).
RELEASE_ENERGY_THRESHOLD=8

# Confirm/release frames (at ~10Hz update rate)
# CONFIRM_FRAMES: how many consecutive readings ≥ STILL_ENERGY_THRESHOLD before
# turning screen ON. 3 = ~0.3s (fast response).
# RELEASE_FRAMES: how many consecutive readings < RELEASE_ENERGY_THRESHOLD before
# turning screen OFF. 10 = ~1s.
CONFIRM_FRAMES=3
RELEASE_FRAMES=10

# LD2420 gate config (max gate to enable)
MAX_GATE=1

# Gate 0 sensitivity (default 30 if not set).
# LD2420 is mounted behind the LCD, so signal is attenuated. Tuning notes:
#   - GATE0_STATIC=20 (default) loses a standing person after ~4s
#   - GATE0_STATIC=10 holds a standing person ~30s (recommended); try 5 if deeper
# Lower = more sensitive. GATE0_MOVING can also be lowered for closer range.
GATE0_MOVING=15
GATE0_STATIC=10

# MQTT discovery prefix
DISCOVERY_PREFIX=homeassistant
