# ==================== MQTT ====================
MQTT_BROKER=mqtt_broker_ip
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# ==================== Telegram Bot ====================
TELEGRAM_BOT_TOKEN=

# ==================== Home Assistant ====================
HA_URL=http://home-assistant-ip:8123
HA_TOKEN=
# HA calendar entity where appointments are pushed for Alexa reminders
HA_CALENDAR_ENTITY=calendar.telegram
# ==================== Bot internals (optional, sensible defaults if omitted) ====================
# Where the bot keeps its SQLite database. Inside the container this should stay
# /data/dashboard.db to match the docker-compose volume mount.
DB_PATH=/data/dashboard.db
LOG_PATH=/var/log/telegram_bot.log
LOG_LEVEL=INFO

# ==================== Recipe suggestions ====================
# "suggest dinner" / "suggest indian" / "suggest vegetarian" / "suggest quick"
# Number of recipes offered per request.
RECIPE_SUGGEST_COUNT=3
# How many days before a suggested recipe may be offered again.
RECIPE_REPEAT_DAYS=28
# How many days before the scraped recipe catalogue is refreshed.
RECIPE_CATALOG_MAX_AGE_DAYS=7

# ==================== General ====================
TZ=Europe/London
